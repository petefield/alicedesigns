@page "/"

<PageTitle>Alice Designs — Objects for everyday rituals</PageTitle>

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow">Made in small batches</p>
        <h1 id="hero-title">Objects for<br /><em>everyday rituals.</em></h1>
        <p class="hero-intro">Thoughtful pieces for slow mornings, generous tables, and the corners you call home.</p>
        <a class="text-link" href="#collection">Explore the collection <span aria-hidden="true">↘</span></a>
    </div>
    <figure class="hero-art">
        <img src="images/hero.png" alt="Hand-drawn green frog illustration" />
    </figure>
</section>

<section class="collection" id="collection" aria-labelledby="collection-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">The latest edition</p>
            <h2 id="collection-title">Gathered goods</h2>
        </div>
        <a class="text-link" href="#notes">View all pieces <span aria-hidden="true">↗</span></a>
    </div>
    <div class="product-grid">
        @foreach (var product in Products)
        {
            <article class="product-card">
                <div class="product-image">
                    <img src="@product.ImageUrl" alt="@product.Name" />
                </div>
                <div class="product-details">
                    <div>
                        <p>@product.Category</p>
                        <h3>@product.Name</h3>
                    </div>
                    <span>@product.Price</span>
                </div>
                </article>
        }
    </div>
</section>

<section class="story" id="story" aria-labelledby="story-title">
    <div class="story-art">
        <img src="images/portrait.png" alt="Silhouette portrait of the maker" />
    </div>
    <div>
        <p class="eyebrow">A note from the studio</p>
        <h2 id="story-title">Useful things,<br /><em>beautifully considered.</em></h2>
        <p>Every Alice Designs piece begins with a simple question: can the familiar feel a little more special? Our objects are made to be used, loved, and passed along.</p>
        <a class="text-link" href="mailto:hello@alicedesigns.example">Meet the maker <span aria-hidden="true">↗</span></a>
    </div>
</section>


@code {
    private static readonly Product[] Products =
    [
        new("Handmade Keyring", "Everyday Essentials", "£5", "images/keyring.png"),
        new("Frog Picture", "For the home", "$36", "images/picture.png"),
        new("Dragon Picture", "For the home", "$36", "images/dragon.png")
    ];

    private sealed record Product(string Name, string Category, string Price, string ImageUrl);
}
